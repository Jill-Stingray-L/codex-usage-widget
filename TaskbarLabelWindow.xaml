<Window x:Class="CodexUsageWidget.TaskbarLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="82"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Border x:Name="LabelSurface"
            CornerRadius="4"
            Cursor="Hand"
            MouseLeftButtonUp="LabelSurface_OnMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#20FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open widget" Click="OpenMenuItem_OnClick" />
                <MenuItem Header="Refresh" Click="RefreshMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Use desktop widget" Click="DesktopModeMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Codex"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="11"
                       Foreground="#E7E7E7" />
            <TextBlock x:Name="UsageText"
                       Margin="5,0,0,0"
                       Text="--%"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />
        </StackPanel>
    </Border>
</Window>
