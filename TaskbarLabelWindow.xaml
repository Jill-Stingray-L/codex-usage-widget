<Window x:Class="CodexUsageWidget.TaskbarLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="142"
        Height="30"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Border x:Name="LabelSurface"
            Background="#F21A2029"
            BorderBrush="#4A5668"
            BorderThickness="1"
            CornerRadius="7"
            Cursor="Hand"
            MouseLeftButtonUp="LabelSurface_OnMouseLeftButtonUp">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open widget" Click="OpenMenuItem_OnClick" />
                <MenuItem Header="Refresh" Click="RefreshMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Use desktop widget" Click="DesktopModeMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#65D892" Margin="0,0,6,0" />
            <TextBlock Text="Codex"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#F4F7FB" />
            <TextBlock Text=" · "
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="10.5"
                       Foreground="#738094" />
            <TextBlock x:Name="UsageText"
                       Text="--% left"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#F4F7FB" />
        </StackPanel>
    </Border>
</Window>
