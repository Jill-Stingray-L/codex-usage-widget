<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage"
        Width="372"
        Height="318"
        MinWidth="372"
        MinHeight="318"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8C99AA" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#AAB4C2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222D3C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsageProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#253142" />
            <Setter Property="Foreground" Value="#65D892" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="3" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="9"
            CornerRadius="24"
            Background="#F2171D27"
            BorderBrush="#354254"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,10,12,4" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="#F1F4F8">
                        <Grid>
                            <Ellipse Width="15" Height="15" Stroke="#111822" StrokeThickness="2.2" />
                            <Ellipse Width="5" Height="5" Fill="#111822" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CODEX USAGE" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#E6A85A" Margin="0,1,5,0" />
                            <TextBlock x:Name="StatusText" Text="Connecting…" FontFamily="{StaticResource UiFont}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Refresh" Style="{StaticResource IconButton}" Click="RefreshButton_OnClick" Content="↻" />
                    <Button ToolTip="Hide to tray" Style="{StaticResource IconButton}" Click="HideButton_OnClick" Content="−" />
                    <Button ToolTip="Exit" Style="{StaticResource IconButton}" Click="CloseButton_OnClick" Content="×" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="22,2,22,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="142" Height="142" VerticalAlignment="Center">
                    <Ellipse Stroke="#263344" StrokeThickness="11" />
                    <Path x:Name="UsageArc"
                          Stroke="#65D892"
                          StrokeThickness="11"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="RemainingText"
                                   Text="--%"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="remaining"
                                   Margin="0,-3,0,0"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel x:Name="PrimaryPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrimaryLabel" Margin="0,0,8,0" Text="Primary window" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource UiFont}" FontSize="11.5" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="PrimaryPercent" Grid.Column="1" Text="--% used" HorizontalAlignment="Right" FontFamily="{StaticResource UiFont}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <ProgressBar x:Name="PrimaryProgress" Margin="0,7,0,5" Style="{StaticResource UsageProgress}" />
                        <TextBlock x:Name="PrimaryReset" Text="Waiting for Codex…" FontFamily="{StaticResource UiFont}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border x:Name="SecondarySeparator" Height="1" Background="#263344" Margin="0,15,0,13" />

                    <StackPanel x:Name="SecondaryPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SecondaryLabel" Margin="0,0,8,0" Text="Secondary window" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource UiFont}" FontSize="11.5" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="SecondaryPercent" Grid.Column="1" Text="--% used" HorizontalAlignment="Right" FontFamily="{StaticResource UiFont}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <ProgressBar x:Name="SecondaryProgress" Margin="0,7,0,5" Style="{StaticResource UsageProgress}" />
                        <TextBlock x:Name="SecondaryReset" Text="No second window" FontFamily="{StaticResource UiFont}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="18,0,18,0" BorderBrush="#263344" BorderThickness="0,1,0,0">
                <Grid Margin="2,0">
                    <TextBlock x:Name="UpdatedText"
                               Text="Local-only · waiting for first sync"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="always on top"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               Foreground="#657184" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
