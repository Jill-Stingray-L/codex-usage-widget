<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage"
        Width="300"
        Height="132"
        MinWidth="300"
        MinHeight="132"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8C99AA" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#AAB4C2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222D3C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsageProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#253142" />
            <Setter Property="Foreground" Value="#65D892" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="6"
            CornerRadius="18"
            Background="#F2171D27"
            BorderBrush="#354254"
            BorderThickness="1"
            MouseLeftButtonDown="Widget_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.38" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="58" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="13,5,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CODEX USAGE"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#E6A85A" Margin="0,1,4,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Connecting…"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Refresh" Style="{StaticResource IconButton}" Click="RefreshButton_OnClick" Content="↻" />
                    <Button ToolTip="Use taskbar indicator" Style="{StaticResource IconButton}" Click="HideButton_OnClick" Content="−" />
                    <Button ToolTip="Exit" Style="{StaticResource IconButton}" Click="CloseButton_OnClick" Content="×" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="RemainingText"
                               Text="--%"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="remaining"
                               Margin="1,-5,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <StackPanel x:Name="PrimaryPanel" Grid.Column="2" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PrimaryLabel"
                                   Margin="0,0,7,0"
                                   Text="Primary window"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="PrimaryPercent"
                                   Grid.Column="1"
                                   Text="--% used"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Grid>
                    <ProgressBar x:Name="PrimaryProgress" Margin="0,6,0,5" Style="{StaticResource UsageProgress}" />
                    <TextBlock x:Name="PrimaryReset"
                               Text="Waiting for Codex…"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="13,0,13,0" BorderBrush="#263344" BorderThickness="0,1,0,0">
                <TextBlock x:Name="UpdatedText"
                           Text="Local-only · waiting for sync"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="8.5"
                           Foreground="{StaticResource TextSecondary}" />
            </Border>
        </Grid>
    </Border>
</Window>
