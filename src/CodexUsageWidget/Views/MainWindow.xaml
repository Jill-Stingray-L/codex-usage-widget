<Window x:Class="CodexUsageWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls"
        Title="Codex Usage"
        Width="390"
        Height="290"
        MinWidth="390"
        MinHeight="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Border x:Name="WidgetSurface"
            Margin="12"
            CornerRadius="16"
            Background="#FA1F1F1F"
            BorderBrush="#343434"
            BorderThickness="1"
            MouseLeftButtonDown="Widget_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.38"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Margin="16,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Codex"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <controls:ActivityDotsIndicator x:Name="WidgetActivityDots"
                                                        Margin="18,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Codex task is running"
                                                        AutomationProperties.Name="Codex task is running"
                                                        DotBrush="{StaticResource AccentDataBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{Binding StatusBrush}"
                                 Margin="0,1,6,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SupportingText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button ToolTip="Activity dots setup"
                            Style="{StaticResource IconButton}"
                            Click="ActivityDotsButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Ellipse Canvas.Left="2" Canvas.Top="7" Width="2.5" Height="2.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Ellipse Canvas.Left="6.75" Canvas.Top="7" Width="2.5" Height="2.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Ellipse Canvas.Left="11.5" Canvas.Top="7" Width="2.5" Height="2.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Refresh usage"
                            Style="{StaticResource IconButton}"
                            Click="RefreshButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M12.5,5.5 A5,5 0 1 0 13,10 M12.5,2.5 L12.5,5.5 L9.5,5.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="DensityButton"
                            ToolTip="Show details"
                            Style="{StaticResource IconButton}"
                            Click="DensityButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M4.5,7 L8,10 L11.5,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="DensityGlyphRotation"
                                                         CenterX="8"
                                                         CenterY="8" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Use taskbar label"
                            Style="{StaticResource IconButton}"
                            Click="HideButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M5,8 L11,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Exit"
                            Style="{StaticResource IconButton}"
                            Click="CloseButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M5,5 L11,11 M11,5 L5,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <controls:CompactUsageView x:Name="CompactView" Grid.Row="1" />
            <controls:DetailedUsageView x:Name="DetailedView"
                                        Grid.Row="1"
                                        Visibility="Collapsed" />

            <Border Grid.Row="2"
                    Margin="16,0,16,0"
                    BorderBrush="#303030"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding UpdatedText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource SupportingText}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextTertiary}" />
            </Border>
        </Grid>
    </Border>
</Window>
