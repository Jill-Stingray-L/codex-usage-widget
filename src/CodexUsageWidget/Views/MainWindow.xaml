<Window x:Class="CodexUsageWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage"
        Width="364"
        Height="182"
        MinWidth="364"
        MinHeight="182"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8C99AA" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Foreground" Value="#AAB4C2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222D3C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetSurface"
            Margin="18"
            CornerRadius="20"
            Background="#F2171D27"
            BorderBrush="#354254"
            BorderThickness="1"
            MouseLeftButtonDown="Widget_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.24" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="78" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,6,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CODEX USAGE"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#E6A85A" Margin="0,1,5,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Connecting…"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Refresh" Style="{StaticResource IconButton}" Click="RefreshButton_OnClick" Content="↻" />
                    <Button ToolTip="Use taskbar label" Style="{StaticResource IconButton}" Click="HideButton_OnClick" Content="−" />
                    <Button ToolTip="Exit" Style="{StaticResource IconButton}" Click="CloseButton_OnClick" Content="×" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="RemainingText"
                               Text="--%"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="remaining"
                               Margin="1,-5,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <StackPanel x:Name="PrimaryPanel" Grid.Column="2" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PrimaryLabel"
                                   Margin="0,0,7,0"
                                   Text="Primary window"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="PrimaryPercent"
                                   Grid.Column="1"
                                   Text="--% used"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Grid>
                    <Grid x:Name="PrimaryProgressTrack" Height="8" Margin="0,9,0,7" ClipToBounds="True">
                        <Border Background="#283548" CornerRadius="4" />
                        <Border x:Name="PrimaryProgressFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="#65D892"
                                CornerRadius="4" />
                    </Grid>
                    <TextBlock x:Name="PrimaryReset"
                               Text="Waiting for Codex…"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="16,0,16,0" BorderBrush="#263344" BorderThickness="0,1,0,0">
                <TextBlock x:Name="UpdatedText"
                           Text="Local-only · waiting for sync"
                           Margin="0,-2,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9.5"
                           Foreground="{StaticResource TextSecondary}" />
            </Border>
        </Grid>
    </Border>
</Window>
