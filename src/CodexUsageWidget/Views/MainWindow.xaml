<Window x:Class="CodexUsageWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage"
        Width="364"
        Height="182"
        MinWidth="364"
        MinHeight="182"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B5B5B5" />
        <SolidColorBrush x:Key="TextTertiary" Color="#969696" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#A8A8A8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#2C2C2C" />
                                <Setter Property="Foreground" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#363636" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetSurface"
            Margin="12"
            CornerRadius="16"
            Background="#FA1F1F1F"
            BorderBrush="#343434"
            BorderThickness="1"
            MouseLeftButtonDown="Widget_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.38"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="78" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Codex"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse x:Name="StatusDot"
                                 Width="5"
                                 Height="5"
                                 Fill="#D6A15F"
                                 Margin="0,1,6,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Connecting..."
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button ToolTip="Refresh usage"
                            Style="{StaticResource IconButton}"
                            Click="RefreshButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M12.5,5.5 A5,5 0 1 0 13,10 M12.5,2.5 L12.5,5.5 L9.5,5.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Use taskbar label"
                            Style="{StaticResource IconButton}"
                            Click="HideButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M5,8 L11,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Exit"
                            Style="{StaticResource IconButton}"
                            Click="CloseButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M5,5 L11,11 M11,5 L5,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="17,0,17,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="RemainingText"
                               Text="--%"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="remaining"
                               Margin="1,-6,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <StackPanel x:Name="PrimaryPanel"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PrimaryLabel"
                                   Margin="0,0,8,0"
                                   Text="Primary window"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="PrimaryPercent"
                                   Grid.Column="1"
                                   Text="--% used"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Grid>

                    <Grid x:Name="PrimaryProgressTrack"
                          Height="6"
                          Margin="0,9,0,8"
                          ClipToBounds="True">
                        <Border Background="#353535" CornerRadius="3" />
                        <Border x:Name="PrimaryProgressFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="#E7E7E7"
                                CornerRadius="3" />
                    </Grid>

                    <TextBlock x:Name="PrimaryReset"
                               Text="Waiting for Codex..."
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Margin="16,0,16,0"
                    BorderBrush="#303030"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="UpdatedText"
                           Text="Local only · waiting for sync"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextTertiary}" />
            </Border>
        </Grid>
    </Border>
</Window>
