<UserControl x:Class="CodexUsageWidget.Views.Controls.ActivityDotsIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="3.75"
             Height="3.75"
             Focusable="False"
             SnapsToDevicePixels="False"
             UseLayoutRounding="False">
    <UserControl.Resources>
        <SineEase x:Key="ActivityWaveEase"
                  EasingMode="EaseInOut" />

        <Storyboard x:Key="ActivityExpandStoryboard"
                    FillBehavior="HoldEnd"
                    Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetName="LeftActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LeftActivityDotTransform"
                             Storyboard.TargetProperty="X"
                             From="0"
                             To="-12"
                             Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterActivityDotTransform"
                             Storyboard.TargetProperty="X"
                             From="0"
                             To="-6"
                             Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ActivityWaveStoryboard"
                    Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetName="LeftActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0.5"
                             BeginTime="0:0:0.4"
                             Duration="0:0:0.46"
                             AutoReverse="True"
                             RepeatBehavior="Forever"
                             EasingFunction="{StaticResource ActivityWaveEase}" />
            <DoubleAnimation Storyboard.TargetName="CenterActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0.5"
                             BeginTime="0:0:0.2"
                             Duration="0:0:0.46"
                             AutoReverse="True"
                             RepeatBehavior="Forever"
                             EasingFunction="{StaticResource ActivityWaveEase}" />
            <DoubleAnimation Storyboard.TargetName="RightActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0.5"
                             Duration="0:0:0.46"
                             AutoReverse="True"
                             RepeatBehavior="Forever"
                             EasingFunction="{StaticResource ActivityWaveEase}" />
        </Storyboard>

        <Storyboard x:Key="ActivityCollapseStoryboard"
                    Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetName="LeftActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LeftActivityDotTransform"
                             Storyboard.TargetProperty="X"
                             From="-12"
                             To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterActivityDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CenterActivityDotTransform"
                             Storyboard.TargetProperty="X"
                             From="-6"
                             To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Canvas Width="3.75"
            Height="3.75"
            RenderOptions.EdgeMode="Unspecified">
        <Ellipse x:Name="LeftActivityDot"
                 Canvas.Left="0"
                 Canvas.Top="0"
                 Width="3.75"
                 Height="3.75"
                 Opacity="0"
                 Fill="{Binding DotBrush, ElementName=Root}">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="LeftActivityDotTransform"
                                    Y="{Binding DotVerticalOffset, ElementName=Root}" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="CenterActivityDot"
                 Canvas.Left="0"
                 Canvas.Top="0"
                 Width="3.75"
                 Height="3.75"
                 Opacity="0"
                 Fill="{Binding DotBrush, ElementName=Root}">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="CenterActivityDotTransform"
                                    Y="{Binding DotVerticalOffset, ElementName=Root}" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RightActivityDot"
                 Canvas.Left="0"
                 Canvas.Top="0"
                 Width="3.75"
                 Height="3.75"
                 Fill="{Binding DotBrush, ElementName=Root}">
            <Ellipse.RenderTransform>
                <TranslateTransform Y="{Binding DotVerticalOffset, ElementName=Root}" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Canvas>
</UserControl>
